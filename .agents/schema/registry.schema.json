{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": ".agents/schema/registry.schema.json",
  "title": "Nomos Registry",
  "description": "Schema for the agent governance registry.yaml — single source of truth for all governance artifacts.",
  "type": "object",
  "required": ["version", "framework_version", "active_profile", "layers", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Registry format version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "framework_version": {
      "type": "string",
      "description": "Governance framework semantic version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "active_profile": {
      "type": "string",
      "enum": ["minimal", "standard", "full"],
      "description": "Active governance profile."
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "mandatory"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "triggers", "layer", "priority", "status", "context_cost"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative path from .agents/ to the artifact file."
          },
          "role": {
            "type": "string",
            "enum": ["capability", "convention", "config", "orchestration"]
          },
          "mode": {
            "type": "string",
            "enum": ["workflow", "skill", "persona", ""]
          },
          "triggers": {
            "type": "object",
            "required": ["phase", "type", "complexity"],
            "additionalProperties": false,
            "properties": {
              "phase": {
                "description": "Single phase or array of phases this artifact applies to.",
                "oneOf": [
                  { "type": "string", "enum": ["plan", "design", "implement", "test", "review", "deploy", "*"] },
                  { "type": "array", "items": { "type": "string", "enum": ["plan", "design", "implement", "test", "review", "deploy", "*"] }, "minItems": 1 }
                ]
              },
              "type": {
                "description": "Single type or array of types this artifact applies to.",
                "oneOf": [
                  { "type": "string", "enum": ["feature", "bugfix", "refactor", "architecture", "research", "docs", "ops", "*"] },
                  { "type": "array", "items": { "type": "string", "enum": ["feature", "bugfix", "refactor", "architecture", "research", "docs", "ops", "*"] }, "minItems": 1 }
                ]
              },
              "complexity": {
                "description": "Single complexity or array of complexities.",
                "oneOf": [
                  { "type": "string", "enum": ["trivial", "standard", "complex", "critical", "*"] },
                  { "type": "array", "items": { "type": "string", "enum": ["trivial", "standard", "complex", "critical", "*"] }, "minItems": 1 }
                ]
              },
              "valid": {
                "type": "boolean",
                "description": "Whether this trigger combination is expected to resolve.",
                "default": true
              }
            }
          },
          "layer": {
            "type": "string",
            "enum": ["base", "phase", "type", "complexity", "project"],
            "description": "Cascade layer this artifact belongs to."
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "status": {
            "type": "string",
            "enum": ["active", "deprecated", "retired"],
            "default": "active"
          },
          "context_cost": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "overridable": {
            "type": "boolean",
            "default": true
          },
          "override_strategy": {
            "type": "string",
            "enum": ["replace", "extend", "prepend"],
            "default": "extend"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "superseded_by": {
            "type": "string"
          }
        }
      }
    }
  }
}
